services:
  prod1:
    image: mongo:7
    container_name: prod1
    entrypoint:
      - bash
      - -c
      - >-
        cp /keyfile.src /data/keyfile &&
        chown 999:999 /data/keyfile &&
        chmod 400 /data/keyfile &&
        exec /usr/local/bin/docker-entrypoint.sh mongod --replSet rs1 --keyFile /data/keyfile --bind_ip_all --port 27317
    environment:
      MONGO_INITDB_ROOT_USERNAME: admin
      MONGO_INITDB_ROOT_PASSWORD: admin123
    volumes: ["./keyfile:/keyfile.src:ro", "prod1_data:/data/db"]
    ports: ["27317:27317"]
    restart: unless-stopped
  prod2:
    image: mongo:7
    container_name: prod2
    entrypoint:
      - bash
      - -c
      - >-
        cp /keyfile.src /data/keyfile &&
        chown 999:999 /data/keyfile &&
        chmod 400 /data/keyfile &&
        exec /usr/local/bin/docker-entrypoint.sh mongod --replSet rs1 --keyFile /data/keyfile --bind_ip_all --port 27318
    environment:
      MONGO_INITDB_ROOT_USERNAME: admin
      MONGO_INITDB_ROOT_PASSWORD: admin123
    volumes: ["./keyfile:/keyfile.src:ro", "prod2_data:/data/db"]
    ports: ["27318:27318"]
    restart: unless-stopped
  prod3:
    image: mongo:7
    container_name: prod3
    entrypoint:
      - bash
      - -c
      - >-
        cp /keyfile.src /data/keyfile &&
        chown 999:999 /data/keyfile &&
        chmod 400 /data/keyfile &&
        exec /usr/local/bin/docker-entrypoint.sh mongod --replSet rs1 --keyFile /data/keyfile --bind_ip_all --port 27319
    environment:
      MONGO_INITDB_ROOT_USERNAME: admin
      MONGO_INITDB_ROOT_PASSWORD: admin123
    volumes: ["./keyfile:/keyfile.src:ro", "prod3_data:/data/db"]
    ports: ["27319:27319"]
    restart: unless-stopped
  exporter:
    image: percona/mongodb_exporter:0.40
    container_name: prod-exporter
    command: ["--mongodb.uri=mongodb://admin:admin123@prod1:27317/?authSource=admin", "--collect-all", "--compatible-mode"]
    ports: ["9216:9216"]
    restart: on-failure

volumes:
  prod1_data:
  prod2_data:
  prod3_data:
  prod-init:
    image: mongo:7
    profiles: ["init"]
    depends_on:
      prod1: {condition: service_started}
      prod2: {condition: service_started}
      prod3: {condition: service_started}
    entrypoint: ["bash", "-lc"]
    command:
      - |
        for i in $(seq 1 60); do
          if mongosh --host prod1 --port 27317 -u admin -p admin123 --authenticationDatabase admin --quiet --eval 'db.adminCommand({ping:1}).ok' >/dev/null 2>&1; then break; fi
          sleep 2
        done
        mongosh --host prod1 --port 27317 -u admin -p admin123 --authenticationDatabase admin --quiet --eval '
          try { rs.status(); print("rs1 already initialized"); }
          catch(e) { rs.initiate({_id:"rs1",members:[{_id:0,host:"host.docker.internal:27317",priority:2},{_id:1,host:"host.docker.internal:27318",priority:1},{_id:2,host:"host.docker.internal:27319",priority:1}]}); }'
        for i in $(seq 1 60); do
          if mongosh --host prod1 --port 27317 -u admin -p admin123 --authenticationDatabase admin --quiet --eval 'quit(db.hello().isWritablePrimary ? 0 : 1)' >/dev/null 2>&1; then echo 'Lab13 rs1 primary ready'; exit 0; fi
          sleep 2
        done
        echo 'Lab13 rs1 primary did not become ready' >&2; exit 1
