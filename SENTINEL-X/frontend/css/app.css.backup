:root{--bg:#080d19;--panel:#101a2b;--panel2:#131f34;--line:#243451;--text:#e8f0ff;--muted:#8fa3c3;--accent:#38d6c3;--blue:#5c9dff;--purple:#a78bfa;--red:#ff647c;--amber:#ffbd69;--green:#55d6a2;--shadow:0 14px 40px #0005;--sw:250px}
[data-theme=light]{--bg:#eef3fa;--panel:#fff;--panel2:#f6f9fd;--line:#dce5f1;--text:#17243a;--muted:#687b98;--accent:#008e83;--blue:#2868c7;--purple:#7652c9;--red:#d83d59;--amber:#b76b13;--green:#178b62;--shadow:0 12px 32px #27456812}
*{box-sizing:border-box}html,body{margin:0;min-height:100%}
body{background:radial-gradient(ellipse at 75% 0%,#17365a55,transparent 38%),var(--bg);color:var(--text);font:14px/1.5 Inter,"Segoe UI",Arial,sans-serif;overflow-x:hidden}
button,input,select,textarea{font:inherit;color:inherit}button{cursor:pointer}a{color:var(--blue)}
.hidden{display:none!important}
/* ---------- layout ---------- */
.app{display:grid;grid-template-columns:var(--sw) minmax(0,1fr);min-height:100vh;transition:grid-template-columns .2s}
body.collapsed{--sw:72px}
.side{position:sticky;top:0;height:100vh;background:var(--panel);border-right:1px solid var(--line);padding:18px 12px;overflow-y:auto;overflow-x:hidden;z-index:30}
.brand{display:flex;gap:12px;align-items:center;padding:0 8px 18px}
.logo{width:40px;height:40px;flex:none;border-radius:12px;background:linear-gradient(135deg,var(--accent),var(--blue));display:grid;place-items:center;color:#07111f;font-weight:900}
.brand b{font-size:15px;letter-spacing:.08em}.brand small{display:block;color:var(--muted);font-size:10px}
.nav{display:grid;gap:3px}
.nav a,.nav summary{display:flex;align-items:center;gap:11px;color:var(--muted);text-decoration:none;padding:10px 12px;border-radius:9px;border:1px solid transparent;cursor:pointer;list-style:none;white-space:nowrap}
.nav summary::-webkit-details-marker{display:none}
.nav a:hover,.nav summary:hover,.nav a.active,.nav details.has-active>summary{background:linear-gradient(90deg,#38d6c31c,#5c9dff12);color:var(--text);border-color:var(--line)}
.ico{width:20px;text-align:center;flex:none}.caret{margin-left:auto;transition:transform .15s}details[open]>summary .caret{transform:rotate(90deg)}
.sub-nav{display:grid;gap:2px;padding:4px 0 6px 18px;margin-left:15px;border-left:1px solid var(--line)}
.sub-nav a{padding:7px 12px;font-size:13px}
.sidefoot{margin-top:22px;padding:12px;border:1px solid var(--line);border-radius:12px;color:var(--muted);font-size:11px}
body.collapsed .lbl,body.collapsed .caret,body.collapsed .sub-nav,body.collapsed .sidefoot,body.collapsed .brand div+div{display:none}
body.collapsed .nav a,body.collapsed .nav summary{justify-content:center;padding:11px 0}
.main{min-width:0;display:flex;flex-direction:column;min-height:100vh}
.top{height:64px;flex:none;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:12px;padding:0 24px;background:#0b1424cc;backdrop-filter:blur(12px);position:sticky;top:0;z-index:20}
[data-theme=light] .top{background:#ffffffd9}
.topleft,.topright{display:flex;align-items:center;gap:10px;min-width:0}.crumb{color:var(--muted);font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.content{width:100%;max-width:1600px;margin:0 auto;padding:24px 26px 44px;flex:1}
.content.fit{display:flex;flex-direction:column;height:calc(100vh - 64px);padding-bottom:20px;overflow:hidden}
.scrim{display:none}
/* ---------- controls ---------- */
.btn{border:1px solid var(--line);background:var(--panel2);color:var(--text);padding:8px 13px;border-radius:9px;transition:filter .15s,transform .15s,border-color .15s;text-decoration:none;display:inline-flex;align-items:center;gap:7px;line-height:1.3}
.btn:hover{filter:brightness(1.12);border-color:var(--accent)}.btn:active{transform:translateY(1px)}
.btn.primary{background:linear-gradient(110deg,#087f83,#2563b8);color:#fff;border:0}.btn.danger{border-color:#ff647c66;color:var(--red)}.btn.sm{padding:4px 9px;font-size:11px}
.btn:disabled{opacity:.5;cursor:not-allowed;filter:none}
input,select,textarea{background:var(--panel2);border:1px solid var(--line);border-radius:9px;padding:9px 11px;min-width:0;outline:none;transition:border-color .15s,box-shadow .15s}
input:focus,select:focus,textarea:focus{border-color:var(--accent);box-shadow:0 0 0 3px #38d6c322}
.toolbar{display:flex;flex-wrap:wrap;gap:9px;align-items:center}.toolbar .grow{flex:1;min-width:180px}
.pill{display:inline-block;border:1px solid var(--line);border-radius:30px;padding:2px 9px;font-size:10px;color:var(--muted);white-space:nowrap}
.pill.ok{color:var(--green);border-color:#55d6a255}.pill.warn{color:var(--amber);border-color:#ffbd6955}.pill.bad{color:var(--red);border-color:#ff647c55}.pill.info{color:var(--blue);border-color:#5c9dff55}
.spinner{width:16px;height:16px;border:2px solid #ffffff55;border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite;display:inline-block}
@keyframes spin{to{transform:rotate(360deg)}}
.loading{display:grid;place-items:center;padding:60px;color:var(--muted);gap:12px}.loading .spinner{border-color:var(--line);border-top-color:var(--accent);width:28px;height:28px}
.empty{display:grid;place-items:center;height:100%;color:var(--muted);font-size:12px;text-align:center;padding:12px}
.errbox{border:1px solid #ff647c55;background:#ff647c14;color:var(--red);padding:12px 14px;border-radius:10px;margin:10px 0}
/* ---------- cards ---------- */
.hero{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:20px;flex-wrap:wrap}
.eyebrow{color:var(--accent);font-size:10px;letter-spacing:.18em;font-weight:800;text-transform:uppercase}
.hero h1{margin:4px 0;font-size:clamp(22px,3vw,32px);letter-spacing:-.03em}.hero p{margin:0;color:var(--muted);max-width:720px}
.live{font-size:11px;color:var(--green);display:flex;gap:7px;align-items:center}.dot{width:7px;height:7px;background:var(--green);border-radius:50%;box-shadow:0 0 12px var(--green)}
.grid{display:grid;gap:14px;margin-bottom:14px}.kpis{grid-template-columns:repeat(4,minmax(0,1fr))}.charts{grid-template-columns:1.2fr 1fr 1fr}.charts2{grid-template-columns:2fr 1fr}.cols2{grid-template-columns:1fr 1fr}.labgrid{grid-template-columns:repeat(3,minmax(0,1fr))}.labdetail{grid-template-columns:1.2fr 1fr}
.kpi,.panel{background:linear-gradient(145deg,var(--panel),var(--panel2));border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);min-width:0}
.kpi{padding:16px 18px;position:relative;overflow:hidden}.kpi:after{content:"";position:absolute;width:90px;height:90px;border-radius:50%;right:-34px;top:-36px;background:var(--glow,#38d6c322)}
.kpi span{color:var(--muted);font-size:11px;letter-spacing:.04em}.kpi strong{display:block;font-size:27px;margin-top:4px;letter-spacing:-.03em}.kpi small{color:var(--muted);font-size:11px}
.panel{padding:16px}.panelhead{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:12px;flex-wrap:wrap}.panel h3{font-size:13px;margin:0}.sub{color:var(--muted);font-size:11px}
.chartbox{height:230px;position:relative}.chartbox.tall{height:270px}
.tablewrap{overflow:auto;max-width:100%}table{width:100%;border-collapse:collapse;min-width:560px}
th,td{text-align:left;padding:9px 9px;border-bottom:1px solid var(--line);font-size:12px;vertical-align:top}th{color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.08em;white-space:nowrap}
tbody tr.click{cursor:pointer}tbody tr.click:hover{background:#38d6c30f}td.trunc{max-width:420px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pager{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:12px;color:var(--muted);font-size:12px;flex-wrap:wrap}
.tabs{display:flex;gap:6px;margin-bottom:14px;flex-wrap:wrap}.tabs button{background:none;border:1px solid transparent;color:var(--muted);padding:8px 14px;border-radius:9px}.tabs button.active{background:var(--panel2);border-color:var(--line);color:var(--text)}
.labcard{padding:18px;text-decoration:none;color:var(--text);display:block;transition:.18s}.labcard:hover{transform:translateY(-3px);border-color:var(--accent)}
.labnum{font-size:10px;color:var(--accent);letter-spacing:.12em;font-weight:800}.labcard h3{margin:8px 0 5px;font-size:16px}.labcard p{color:var(--muted);font-size:12px;min-height:36px;margin:0}.labmeta{display:flex;justify-content:space-between;align-items:center;color:var(--muted);font-size:11px;margin-top:12px}
.runlist{display:grid;gap:9px}.runitem{border:1px solid var(--line);border-radius:10px;padding:12px;display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap}.runitem b{font-size:12px}.runitem small{display:block;color:var(--muted);font-size:11px}.runitem code{display:block;margin-top:4px;font-size:11px;color:var(--accent);word-break:break-all}
.output,.codeview{background:#060a12;color:#c6e4ff;border:1px solid var(--line);border-radius:10px;padding:12px;white-space:pre-wrap;word-break:break-word;max-height:340px;overflow:auto;font:11px/1.5 Consolas,"Courier New",monospace;margin:0}
[data-theme=light] .output,[data-theme=light] .codeview{background:#f1f5fb;color:#1a2b45}
.steps{margin:0;padding-left:20px;color:var(--text);font-size:12px;display:grid;gap:5px}.kv{display:grid;gap:6px;font-size:12px}.kv b{color:var(--muted);font-weight:600;margin-right:6px}
.sourcegrid{grid-template-columns:repeat(4,minmax(0,1fr))}.source{padding:12px;border:1px solid var(--line);border-radius:10px;min-width:0}.source b{font-size:12px}.source small{display:block;color:var(--muted);font-size:11px;margin-top:4px;overflow:hidden;text-overflow:ellipsis}
.alertlist{display:grid;gap:8px}.alert{border:1px solid var(--line);border-left:3px solid var(--amber);border-radius:8px;padding:10px 12px;font-size:12px;background:var(--panel2)}.alert.bad{border-left-color:var(--red)}
.audit-success{color:var(--green)}.audit-fail{color:var(--red)}
/* ---------- drawer ---------- */
.drawerwrap{position:fixed;inset:0;background:#0009;z-index:60;display:flex;justify-content:flex-end}
.drawer{width:min(560px,100%);height:100%;background:var(--panel);border-left:1px solid var(--line);padding:22px;overflow:auto;animation:slide .18s}
@keyframes slide{from{transform:translateX(40px);opacity:0}}
.drawer h2{margin:0 0 6px;font-size:18px;overflow-wrap:anywhere}
/* ---------- chat ---------- */
.chat{display:flex;flex-direction:column;background:linear-gradient(145deg,var(--panel),var(--panel2));border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);min-height:0;height:100%}
.chat.compact{height:520px}.chathead{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:12px 16px;border-bottom:1px solid var(--line);flex-wrap:wrap}
.messages{flex:1;min-height:0;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:14px;scroll-behavior:smooth}
.row{display:flex;gap:10px;max-width:100%}.row.user{flex-direction:row-reverse}
.avatar{width:30px;height:30px;border-radius:50%;flex:none;display:grid;place-items:center;font-size:11px;font-weight:800;background:linear-gradient(135deg,var(--accent),var(--blue));color:#07111f}.row.user .avatar{background:var(--purple)}
.bubble{max-width:min(78%,860px);padding:10px 14px;border:1px solid var(--line);border-radius:14px;background:var(--panel2);font-size:13px;overflow-wrap:anywhere}
.row.user .bubble{background:#145a7770;border-top-right-radius:4px}.row.bot .bubble{border-top-left-radius:4px}.bubble code{background:#0003;padding:1px 5px;border-radius:5px;font-size:12px}
.tag{display:inline-block;margin-bottom:6px;font-size:10px}
.codeblock{margin:8px 0;border:1px solid var(--line);border-radius:10px;overflow:hidden;background:#060a12}[data-theme=light] .codeblock{background:#f1f5fb}
.codehead{display:flex;justify-content:space-between;align-items:center;padding:5px 10px;background:#ffffff0d;font-size:11px;color:var(--muted)}
.codeblock pre{margin:0;padding:10px 12px;overflow:auto;font:12px/1.5 Consolas,"Courier New",monospace;max-height:340px}.codeblock code{background:none;padding:0}
.typing{display:inline-flex;gap:4px;padding:4px 0}.typing i{width:7px;height:7px;border-radius:50%;background:var(--muted);animation:bounce 1.2s infinite}.typing i:nth-child(2){animation-delay:.15s}.typing i:nth-child(3){animation-delay:.3s}
@keyframes bounce{0%,60%,100%{transform:translateY(0);opacity:.5}30%{transform:translateY(-5px);opacity:1}}
.composer{display:flex;gap:10px;padding:12px 14px;border-top:1px solid var(--line);align-items:flex-end}.composer textarea{flex:1;resize:none;max-height:140px;line-height:1.4}
/* ---------- authentication ---------- */
.authscreen{position:fixed;inset:0;display:grid;place-items:center;padding:20px;overflow:auto;
 background:radial-gradient(ellipse at 20% 15%,#1b3d6b66,transparent 45%),radial-gradient(ellipse at 85% 85%,#38d6c326,transparent 45%),linear-gradient(160deg,#050912,#0b1426 55%,#0a1f2e)}
.authcard{width:min(420px,100%);padding:30px 28px;border-radius:20px;background:#101a2bcc;backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);border:1px solid #ffffff1c;box-shadow:0 24px 70px #000a;color:#e8f0ff}
.authcard h1{margin:0 0 20px;font-size:24px;text-align:center;letter-spacing:-.02em}
.authfield{display:grid;gap:6px;margin:0 0 14px}.authfield label{font-size:12px;color:#8fa3c3}.authfield input{width:100%;padding:12px;background:#131f34;border-color:#243451;color:#e8f0ff}
.pwwrap{position:relative}.pwwrap input{padding-right:64px}.pwwrap button{position:absolute;right:6px;top:50%;transform:translateY(-50%);background:none;border:0;color:#8fa3c3;padding:6px 8px;font-size:12px}
.authmsg{min-height:20px;font-size:12px;margin:2px 0 12px;color:#ff647c}.authmsg.ok{color:#55d6a2}
.authcard .btn.primary{width:100%;justify-content:center;padding:12px}.authlink{margin-top:18px;text-align:center;font-size:13px;color:#8fa3c3}.authhint{font-size:11px;color:#8fa3c3}
/* ---------- responsive ---------- */
@media(max-width:1200px){.kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.charts{grid-template-columns:1fr 1fr}.charts>.panel:first-child{grid-column:1/-1}.labgrid{grid-template-columns:repeat(2,minmax(0,1fr))}.sourcegrid{grid-template-columns:repeat(2,minmax(0,1fr))}.charts2,.labdetail,.cols2{grid-template-columns:1fr}}
@media(max-width:860px){body.collapsed{--sw:250px}.app{grid-template-columns:minmax(0,1fr)}
 .side{position:fixed;left:0;top:0;width:270px;transform:translateX(-105%);transition:transform .2s;box-shadow:var(--shadow)}
 body.navopen .side{transform:none}body.navopen .scrim{display:block;position:fixed;inset:0;background:#0008;z-index:25}
 body.collapsed .lbl,body.collapsed .caret,body.collapsed .sub-nav,body.collapsed .sidefoot,body.collapsed .brand div+div{display:revert}
 .top{padding:0 14px}.content{padding:18px 14px 40px}.charts{grid-template-columns:1fr}.bubble{max-width:90%}.userchip .lbl{display:none}}
@media(max-width:560px){.kpis{grid-template-columns:1fr 1fr}.labgrid,.sourcegrid{grid-template-columns:1fr}.hero{display:block}.kpi strong{font-size:22px}}

/* ---------- Boss: saved conversations (ChatGPT-style) ---------- */
.chat.chatx{display:grid;grid-template-columns:270px minmax(0,1fr);overflow:hidden;position:relative}
.chatmain{display:flex;flex-direction:column;min-height:0;min-width:0}
.convpane{display:flex;flex-direction:column;gap:8px;padding:12px;border-right:1px solid var(--line);min-height:0;background:linear-gradient(180deg,var(--panel2),var(--panel))}
.convitems{flex:1;min-height:0;overflow-y:auto;margin:0 -4px;padding:0 4px}
.convgroup{font-size:10px;letter-spacing:.1em;color:var(--muted);text-transform:uppercase;padding:12px 6px 4px;font-weight:700}
.convitem{display:flex;align-items:center;justify-content:space-between;gap:6px;padding:7px 8px;border-radius:9px;cursor:pointer;border:1px solid transparent;outline:none}
.convitem:hover,.convitem:focus-visible,.convitem.active{background:linear-gradient(90deg,#38d6c31c,#5c9dff12);border-color:var(--line)}
.convitem.active .ctitle{color:var(--accent);font-weight:600}
.ctitle{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:13px}
.cacts{display:none;gap:1px;flex:none}.convitem:hover .cacts,.convitem:focus-within .cacts,.convitem.active .cacts{display:flex}
.cacts button{background:none;border:0;padding:2px 5px;border-radius:6px;font-size:12px;color:var(--muted);line-height:1.3}
.cacts button:hover{color:var(--text);background:var(--panel2)}
.convtitle{max-width:240px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:13px}
.msgacts{display:flex;gap:6px;margin-top:8px;opacity:0;transition:opacity .15s}
.bubble:hover .msgacts,.row.islast .msgacts{opacity:1}
.act-last{display:none}.row.islast .act-last{display:inline-flex}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}
.chip{border:1px solid var(--line);background:var(--panel);border-radius:20px;padding:6px 12px;font-size:12px;transition:border-color .15s}
.chip:hover{border-color:var(--accent)}
.btn.rec{background:var(--red);color:#fff;border-color:var(--red);animation:recpulse 1.2s infinite}
@keyframes recpulse{50%{opacity:.6}}
@media (min-width:861px){.chat.chatx:not(.compact) #cvToggle{display:none}}
.chat.chatx.compact,.chat.chatx.compact .chathead{position:relative}
.chat.chatx.compact{grid-template-columns:minmax(0,1fr)}
.chat.chatx.compact .convpane{position:absolute;z-index:5;top:0;bottom:0;left:0;width:270px;transform:translateX(-102%);transition:transform .2s;box-shadow:var(--shadow);background:var(--panel)}
.chat.chatx.compact.showlist .convpane{transform:none}
@media (max-width:860px){
  .chat.chatx{grid-template-columns:minmax(0,1fr)}
  .chat.chatx .convpane{position:absolute;z-index:5;top:0;bottom:0;left:0;width:270px;transform:translateX(-102%);transition:transform .2s;box-shadow:var(--shadow);background:var(--panel)}
  .chat.chatx.showlist .convpane{transform:none}
}

/* SENTINEL-X access portal refresh */
.authscreen{display:grid!important;grid-template-columns:minmax(260px,460px) minmax(320px,440px);gap:clamp(28px,6vw,90px);align-items:center;justify-content:center;padding:5vh 5vw!important;background:radial-gradient(ellipse at 18% 20%,rgba(32,119,214,.22),transparent 45%),radial-gradient(ellipse at 85% 80%,rgba(29,199,171,.13),transparent 40%),var(--bg)!important;min-height:100vh}
.authbrand{max-width:440px;animation:sxRise .7s ease both}.authbrandmark{width:68px;height:68px;border-radius:20px;display:grid;place-items:center;background:linear-gradient(135deg,#0875d1,#18b99d);font-size:25px;font-weight:900;color:white;box-shadow:0 18px 50px #0875d144;margin-bottom:28px}.authbrand h1{font-size:clamp(38px,5vw,62px);letter-spacing:-2px;margin:12px 0}.authbrand p{font-size:16px;line-height:1.7;color:var(--muted)}.authfeatures{display:flex;flex-wrap:wrap;gap:9px;margin-top:26px}.authfeatures span{border:1px solid var(--line);background:var(--panel);padding:9px 12px;border-radius:999px;font-size:12px;color:var(--muted)}.authcard{animation:sxRise .8s .08s ease both;box-shadow:0 25px 90px #0002!important;border:1px solid var(--line)!important;backdrop-filter:blur(16px)}.authcard h1{letter-spacing:-.7px}.authcard .authhint{display:block;line-height:1.55;margin:5px 0 15px}@keyframes sxRise{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}@media(max-width:760px){.authscreen{grid-template-columns:1fr;gap:20px;padding:28px!important}.authbrand{max-width:560px}.authbrandmark{width:52px;height:52px;margin-bottom:12px}.authbrand h1{font-size:36px}}

.perm-lab{display:flex;gap:9px;align-items:center;padding:9px 11px;border:1px solid var(--line);border-radius:10px;background:var(--panel);font-size:13px}.perm-lab input,.toolbar label input{accent-color:#159b88}

/* Boss ChatGPT-style fixed composer and attachment tray */
.chat.chatx:not(.compact){height:100%;min-height:0}
.chat.chatx .chatmain{height:100%;min-height:0;overflow:hidden}
.chat.chatx .messages{overscroll-behavior:contain;scrollbar-gutter:stable}
.chat.chatx .composer{flex:none;background:var(--panel);align-items:flex-end;position:relative}
.chat.chatx .composer textarea{min-height:44px;max-height:150px}
.attach-preview{display:none;flex:none;gap:7px;flex-wrap:wrap;padding:8px 14px 0;background:var(--panel)}
.attach-preview.has-files{display:flex}
.attach-chip{display:inline-flex;align-items:center;gap:7px;max-width:260px;border:1px solid var(--line);border-radius:10px;padding:5px 9px;background:var(--panel2);font-size:11px;overflow-wrap:anywhere}
.attach-chip button{border:0;background:transparent;color:var(--muted);font-size:16px;padding:0 2px}
.attach-btn{width:42px;height:42px;justify-content:center;font-size:22px;padding:0;flex:none}
.user-attachments{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.user-attachments span{border:1px solid var(--line);background:var(--panel);border-radius:8px;padding:4px 7px;font-size:10px;color:var(--muted)}
@media(max-width:560px){.chat.chatx .composer{gap:6px;padding:9px}.attach-btn{width:38px;height:40px}.chat.chatx .composer textarea{font-size:13px}}
