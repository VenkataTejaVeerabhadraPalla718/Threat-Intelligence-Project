FROM docker:cli AS docker_cli

FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/backend
ENV CTI_MONGO_URI=mongodb://mongo1:27117,mongo2:27118,mongo3:27119/?replicaSet=rs0
ENV API_BASE_URL=http://host.docker.internal:8000/api
ENV CASSANDRA_HOST=host.docker.internal
ENV NEO4J_URI=bolt://host.docker.internal:7687
ENV OLLAMA_URL=http://host.docker.internal:11434

WORKDIR /app

COPY --from=docker_cli /usr/local/bin/docker /usr/local/bin/docker
COPY backend/requirements.txt /app/backend/requirements.txt
RUN python -m pip install --no-cache-dir -r /app/backend/requirements.txt

COPY backend/ /app/backend/

ARG LAB_ID
RUN case "$LAB_ID" in \
      lab13|lab14|lab15|lab16|lab17|lab18) ;; \
      *) echo "LAB_ID must be lab13 through lab18" >&2; exit 1 ;; \
    esac
ENV LAB_ID=${LAB_ID}
LABEL org.opencontainers.image.title="CTI ${LAB_ID}"
COPY labs/${LAB_ID}/ /app/labs/${LAB_ID}/
COPY docker/lab_runner.py /app/docker/lab_runner.py

ENTRYPOINT ["python", "/app/docker/lab_runner.py"]
